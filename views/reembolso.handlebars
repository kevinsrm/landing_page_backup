{{!-- ======================= NAV ======================= --}}
<header class="sticky top-0 z-40 border-b border-white/5 bg-slate-950/80 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6">
    <a href="/" class="flex items-center gap-2.5">
      <span class="grid h-9 w-9 place-items-center rounded-xl bg-brand-600 text-white">{{icone "bolt" class="w-5 h-5"}}</span>
      <span class="font-display text-lg font-bold tracking-tight text-white">{{nomeLoja}}</span>
    </a>
    <a href="/" class="btn-ghost px-4 py-2 text-sm">{{icone "arrow-left" class="w-4 h-4"}} Voltar</a>
  </div>
</header>

<div class="relative mx-auto max-w-2xl px-4 py-14 sm:px-6">
  <div class="pointer-events-none absolute -top-20 left-1/2 h-[320px] w-[560px] -translate-x-1/2 rounded-full bg-brand-600/20 blur-[110px]"></div>

  <div class="relative animate-fade-up text-center">
    <span class="eyebrow">{{icone "refund" class="w-3.5 h-3.5"}} Garantia de 7 dias</span>
    <h1 class="section-title mt-4">Solicitar reembolso</h1>
    <p class="mt-3 text-slate-400">
      Preencha os dados abaixo. Nossa equipe analisa a solicitação e o estorno é feito pelo próprio Mercado Pago.
    </p>
  </div>

  <form id="form-reembolso" class="card relative mt-8 space-y-5 p-6 sm:p-8">
    <div>
      <label class="label" for="email">E-mail usado na compra</label>
      <input id="email" name="email" type="email" required class="field validate" placeholder="voce@email.com">
    </div>

    <div>
      <label class="label" for="payment_id">ID do pagamento</label>
      <input id="payment_id" name="payment_id" type="text" required class="field validate" placeholder="Ex: 153243392142">
      <p class="mt-1.5 text-xs text-slate-500">Está no comprovante do Pix ou no e-mail de confirmação da compra.</p>
    </div>

    <div>
      <label class="label" for="motivo">Motivo da solicitação</label>
      <textarea id="motivo" name="motivo" rows="5" required class="field validate resize-y" placeholder="Conte o que aconteceu…"></textarea>
    </div>

    <div id="retorno" class="hidden items-start gap-2 rounded-xl border p-3 text-sm"></div>

    <button id="btn-enviar" type="submit" class="btn-primary w-full">
      {{icone "send" class="w-4 h-4"}} Enviar solicitação
    </button>

    <p class="flex items-center justify-center gap-1.5 text-center text-xs text-slate-500">
      {{icone "lock" class="w-3.5 h-3.5"}} Solicitação segura · processada via Mercado Pago
    </p>
  </form>

  <p class="mt-6 text-center text-xs text-slate-600">
    O prazo de análise pode variar conforme o método de pagamento utilizado.
  </p>
</div>

<script>
(() => {
  const formulario = document.getElementById("form-reembolso");
  const botao = document.getElementById("btn-enviar");
  const retorno = document.getElementById("retorno");
  const obrigatorios = Array.from(document.querySelectorAll(".validate"));

  function sincronizar() {
    botao.disabled = obrigatorios.some((campo) => campo.value.trim() === "");
  }
  obrigatorios.forEach((campo) => campo.addEventListener("input", sincronizar));
  sincronizar();

  formulario.addEventListener("submit", async (evento) => {
    evento.preventDefault();
    botao.disabled = true;
    botao.textContent = "Enviando…";

    const corpo = {
      email: document.getElementById("email").value.trim(),
      payment_id: document.getElementById("payment_id").value.trim(),
      motivo: document.getElementById("motivo").value.trim(),
    };

    try {
      const resposta = await fetch("/reembolsauser", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(corpo),
      });
      const dados = await resposta.json();
      if (!resposta.ok) throw new Error(dados.erro || "Não foi possível enviar a solicitação.");

      retorno.className = "flex items-start gap-2 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3 text-sm text-emerald-200";
      retorno.textContent = "Solicitação recebida! Você receberá a resposta no e-mail informado.";
      formulario.reset();
    } catch (erro) {
      retorno.className = "flex items-start gap-2 rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-sm text-rose-200";
      retorno.textContent = erro.message;
      botao.disabled = false;
      botao.innerHTML = "Enviar solicitação";
    }
  });
})();
</script>
