<div class="min-h-dvh bg-slate-950 lg:flex">

  {{!-- ======================= SIDEBAR ======================= --}}
  <aside id="sidebar"
         class="fixed inset-y-0 left-0 z-50 w-72 -translate-x-full border-r border-white/5 bg-slate-950 transition-transform duration-300 lg:static lg:translate-x-0">
    <div class="flex h-16 items-center gap-2.5 border-b border-white/5 px-5">
      <span class="grid h-9 w-9 place-items-center rounded-xl bg-brand-600 text-white">{{icone "bolt" class="w-5 h-5"}}</span>
      <div>
        <p class="font-display text-sm font-bold text-white">{{nomeLoja}}</p>
        <p class="text-[11px] text-slate-500">Painel administrativo</p>
      </div>
      <button id="fechar-menu" type="button" class="ml-auto grid h-8 w-8 place-items-center rounded-lg text-slate-400 lg:hidden">
        {{icone "x" class="w-4 h-4"}}
      </button>
    </div>

    <div class="flex items-center gap-3 border-b border-white/5 px-5 py-4">
      <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-500/15 text-sm font-bold text-brand-300">
        {{iniciais admin}}
      </span>
      <div class="min-w-0">
        <p class="text-sm font-semibold text-white">Administrador</p>
        <p class="truncate text-xs text-slate-500">{{admin}}</p>
      </div>
    </div>

    <nav class="space-y-1 px-3 py-4">
      <p class="px-3 pb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-600">Gestão</p>
      <button type="button" data-secao="visao" class="nav-item flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition">
        {{icone "chart" class="w-4.5 h-4.5"}} Visão geral
      </button>
      <button type="button" data-secao="vendas" class="nav-item flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition">
        {{icone "cart" class="w-4.5 h-4.5"}} Vendas
        <span class="ml-auto rounded-full bg-white/5 px-2 py-0.5 text-[11px] text-slate-400">{{totais.aprovados}}</span>
      </button>
      <button type="button" data-secao="reembolsos" class="nav-item flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition">
        {{icone "refund" class="w-4.5 h-4.5"}} Reembolsos
      </button>

      <p class="px-3 pb-2 pt-5 text-[11px] font-semibold uppercase tracking-wider text-slate-600">Loja</p>
      <button type="button" data-secao="produto" class="nav-item flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition">
        {{icone "package" class="w-4.5 h-4.5"}} Produto
      </button>
      <button type="button" data-secao="entrega" class="nav-item flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition">
        {{icone "download" class="w-4.5 h-4.5"}} Link de download
      </button>

      <div class="my-4 h-px bg-white/5"></div>
      <a href="/" class="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-400 transition hover:bg-white/5 hover:text-white">
        {{icone "home" class="w-4.5 h-4.5"}} Ver landing page
      </a>
      <a href="/logout" class="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-400 transition hover:bg-rose-500/10 hover:text-rose-300">
        {{icone "logout" class="w-4.5 h-4.5"}} Sair
      </a>
    </nav>
  </aside>

  <div id="overlay-menu" class="fixed inset-0 z-40 hidden bg-slate-950/70 backdrop-blur-sm lg:hidden"></div>

  {{!-- ======================= CONTEÚDO ======================= --}}
  <div class="flex min-w-0 flex-1 flex-col">
    <header class="sticky top-0 z-30 flex h-16 items-center gap-3 border-b border-white/5 bg-slate-950/85 px-4 backdrop-blur-xl sm:px-6">
      <button id="abrir-menu" type="button" class="grid h-9 w-9 place-items-center rounded-lg border border-white/10 text-slate-300 lg:hidden">
        {{icone "menu" class="w-4 h-4"}}
      </button>
      <h1 id="titulo-secao" class="font-display text-lg font-bold text-white">Visão geral</h1>
      <span class="ml-auto hidden items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-slate-400 sm:flex">
        {{icone "pix" class="w-3.5 h-3.5 text-pix-400"}} Checkout Pix ativo
      </span>
    </header>

    <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">

      {{#if aviso}}
        <div class="mb-6 flex items-start gap-3 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-sm text-emerald-200">
          {{icone "check-circle" class="mt-0.5 w-5 h-5 shrink-0"}}
          <p>{{aviso}}</p>
        </div>
      {{/if}}
      {{#if alerta}}
        <div class="mb-6 flex items-start gap-3 rounded-2xl border border-rose-500/30 bg-rose-500/10 p-4 text-sm text-rose-200">
          {{icone "alert" class="mt-0.5 w-5 h-5 shrink-0"}}
          <p>{{alerta}}</p>
        </div>
      {{/if}}

      {{!-- ---------- VISÃO GERAL ---------- --}}
      <section data-conteudo="visao" class="space-y-6">
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <div class="card p-5">
            <div class="flex items-center justify-between">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Faturamento</p>
              <span class="grid h-9 w-9 place-items-center rounded-xl bg-emerald-500/15 text-emerald-300">{{icone "trending" class="w-4.5 h-4.5"}}</span>
            </div>
            <p class="mt-3 font-display text-2xl font-extrabold text-white">{{moeda totais.faturamento}}</p>
            <p class="mt-1 text-xs text-slate-500">Total de vendas aprovadas</p>
          </div>

          <div class="card p-5">
            <div class="flex items-center justify-between">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Hoje</p>
              <span class="grid h-9 w-9 place-items-center rounded-xl bg-brand-500/15 text-brand-300">{{icone "bolt" class="w-4.5 h-4.5"}}</span>
            </div>
            <p class="mt-3 font-display text-2xl font-extrabold text-white">{{moeda totais.faturamentoHoje}}</p>
            <p class="mt-1 text-xs text-slate-500">Aprovado nas últimas 24h</p>
          </div>

          <div class="card p-5">
            <div class="flex items-center justify-between">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Vendas aprovadas</p>
              <span class="grid h-9 w-9 place-items-center rounded-xl bg-pix-500/15 text-pix-300">{{icone "check-circle" class="w-4.5 h-4.5"}}</span>
            </div>
            <p class="mt-3 font-display text-2xl font-extrabold text-white">{{totais.aprovados}}</p>
            <p class="mt-1 text-xs text-slate-500">{{totais.recusados}} recusadas · {{totais.pendentes}} pendentes</p>
          </div>

          <div class="card p-5">
            <div class="flex items-center justify-between">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Link de download</p>
              <span class="grid h-9 w-9 place-items-center rounded-xl bg-brand-500/15 text-brand-300">{{icone "link" class="w-4.5 h-4.5"}}</span>
            </div>
            {{#if link_download}}
              <p class="mt-3 truncate font-mono text-xs text-emerald-300" title="{{link_download}}">{{link_download}}</p>
              <p class="mt-1 text-xs text-slate-500">Configurado · enviado no e-mail</p>
            {{else}}
              <p class="mt-3 text-sm font-semibold text-amber-300">Não configurado</p>
              <p class="mt-1 text-xs text-slate-500">O e-mail de download não será enviado</p>
            {{/if}}
          </div>
        </div>

        <div class="card p-5 sm:p-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 class="font-display text-lg font-semibold text-white">Vendas dos últimos 7 dias</h2>
              <p class="text-sm text-slate-500">Pedidos aprovados por dia</p>
            </div>
            <span class="badge-info">{{icone "pix" class="w-3.5 h-3.5"}} Pix</span>
          </div>
          <div id="grafico" class="mt-4 h-72 w-full"></div>
        </div>

        <div>
          <div class="mb-3 flex items-center justify-between">
            <h2 class="font-display text-lg font-semibold text-white">Últimas vendas</h2>
            <button type="button" data-secao="vendas" class="nav-item-link text-sm font-semibold text-brand-300 transition hover:text-brand-200">
              Ver todas
            </button>
          </div>
          {{> tabela-pedidos lista=pedidos tipo="aprovado" vazio="Nenhuma venda aprovada ainda."}}
        </div>
      </section>

      {{!-- ---------- VENDAS ---------- --}}
      <section data-conteudo="vendas" class="hidden space-y-5">
        <div class="flex flex-wrap gap-2">
          <button type="button" data-aba="aprovadas" class="aba rounded-xl px-4 py-2 text-sm font-semibold transition">
            Aprovadas <span class="ml-1 text-xs opacity-70">{{totais.aprovados}}</span>
          </button>
          <button type="button" data-aba="pendentes" class="aba rounded-xl px-4 py-2 text-sm font-semibold transition">
            Pendentes <span class="ml-1 text-xs opacity-70">{{totais.pendentes}}</span>
          </button>
          <button type="button" data-aba="recusadas" class="aba rounded-xl px-4 py-2 text-sm font-semibold transition">
            Recusadas <span class="ml-1 text-xs opacity-70">{{totais.recusados}}</span>
          </button>
        </div>

        <div data-painel-aba="aprovadas">
          {{> tabela-pedidos lista=pedidos tipo="aprovado" vazio="Nenhuma venda aprovada ainda."}}
        </div>
        <div data-painel-aba="pendentes" class="hidden">
          {{> tabela-pedidos lista=pedidos_pendentes tipo="pendente" vazio="Nenhum pagamento pendente."}}
        </div>
        <div data-painel-aba="recusadas" class="hidden">
          {{> tabela-pedidos lista=pedidos_falha tipo="rejeitado" vazio="Nenhum pagamento recusado."}}
        </div>
      </section>

      {{!-- ---------- REEMBOLSOS ---------- --}}
      <section data-conteudo="reembolsos" class="hidden space-y-5">
        <div class="card p-6">
          <h2 class="font-display text-lg font-semibold text-white">Solicitações de reembolso</h2>
          <p class="mt-1 text-sm text-slate-500">Pedidos abertos pelos clientes na central de suporte.</p>
        </div>

        {{#if reembolsos.length}}
          <div class="overflow-hidden rounded-2xl border border-white/10 bg-slate-900/60">
            <div class="overflow-x-auto">
              <table class="w-full min-w-[720px] text-left text-sm">
                <thead class="border-b border-white/10 bg-white/[0.03] text-[11px] uppercase tracking-wider text-slate-400">
                  <tr>
                    <th class="px-5 py-3.5 font-semibold">Cliente</th>
                    <th class="px-5 py-3.5 font-semibold">Pagamento</th>
                    <th class="px-5 py-3.5 font-semibold">Motivo</th>
                    <th class="px-5 py-3.5 font-semibold">Status</th>
                    <th class="px-5 py-3.5 text-right font-semibold">Ação</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                  {{#each reembolsos}}
                    <tr class="transition hover:bg-white/[0.03]">
                      <td class="px-5 py-4">
                        <p class="font-semibold text-white">{{this.email}}</p>
                        <p class="text-xs text-slate-500">{{dataHora this.data_pedido}}</p>
                      </td>
                      <td class="px-5 py-4 font-mono text-xs text-slate-300">{{this.payment_id}}</td>
                      <td class="max-w-xs px-5 py-4 text-slate-300">{{this.motivo}}</td>
                      <td class="px-5 py-4">
                        {{#if (eq this.status "pendente")}}<span class="badge-warning">Pendente</span>{{/if}}
                        {{#if (eq this.status "aprovado")}}<span class="badge-success">Estornado</span>{{/if}}
                        {{#if (eq this.status "recusado")}}<span class="badge-danger">Recusado</span>{{/if}}
                      </td>
                      <td class="px-5 py-4 text-right">
                        {{#if (eq this.status "pendente")}}
                          <form method="POST" action="/refund" class="inline">
                            <input type="hidden" name="id" value="{{this.id}}">
                            <input type="hidden" name="payment_id" value="{{this.payment_id}}">
                            <button type="submit"
                                    class="inline-flex items-center gap-1.5 rounded-lg bg-brand-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-brand-500">
                              {{icone "refund" class="w-3.5 h-3.5"}} Estornar no Mercado Pago
                            </button>
                          </form>
                        {{else}}
                          <span class="text-xs text-slate-500">—</span>
                        {{/if}}
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
        {{else}}
          <div class="card flex flex-col items-center gap-3 px-6 py-16 text-center">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-white/5 text-slate-500">{{icone "refund" class="w-6 h-6"}}</span>
            <p class="text-sm text-slate-400">Nenhuma solicitação de reembolso até agora.</p>
          </div>
        {{/if}}
      </section>

      {{!-- ---------- PRODUTO ---------- --}}
      <section data-conteudo="produto" class="hidden">
        <div class="grid gap-6 xl:grid-cols-[1.2fr_.8fr]">
          <form method="POST" action="/validateupload" enctype="multipart/form-data" class="card space-y-6 p-6 sm:p-8">
            <div>
              <h2 class="font-display text-lg font-semibold text-white">Editar produto</h2>
              <p class="mt-1 text-sm text-slate-500">Preços, descrição e imagens exibidos na landing page.</p>
            </div>

            <input type="hidden" name="id" value="1">

            <div>
              <label class="label" for="nome">Nome do produto</label>
              <input id="nome" name="nome" type="text" maxlength="120"
                     value="{{produto.nome}}" placeholder="Ex.: iPhone 17 Pro Max 256GB" class="field">
              <p class="mt-1.5 text-xs text-slate-500">Este nome aparece na landing page, no resumo do pedido, no QR Code PIX e nos e-mails.</p>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label class="label" for="preco_sem_desconto">Preço sem desconto</label>
                <input id="preco_sem_desconto" name="preco_sem_desconto" type="text" inputmode="decimal"
                       value="{{produto.preco_sem_desconto}}" placeholder="297,00" class="field">
              </div>
              <div>
                <label class="label" for="preco">Preço com desconto (cobrado no Pix)</label>
                <input id="preco" name="preco" type="text" inputmode="decimal"
                       value="{{produto.preco_com_desconto}}" placeholder="97,00" class="field">
              </div>
            </div>

            <div>
              <label class="label" for="descricao">Descrição</label>
              <textarea id="descricao" name="descricao" rows="8" maxlength="5000"
                        class="field resize-y leading-relaxed" placeholder="Descreva o produto…">{{produto.descricao}}</textarea>
              <p class="mt-1.5 text-xs text-slate-500">A descrição aparece no topo da página e no e-mail de compra.</p>
            </div>

            <div>
              <span class="label">Imagens do produto (4)</span>
              <label for="upload"
                     class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-white/15 bg-white/[0.02] px-6 py-10 text-center transition hover:border-brand-400/60 hover:bg-white/[0.04]">
                {{icone "image" class="w-7 h-7 text-slate-500"}}
                <span class="text-sm font-medium text-slate-300">Clique para selecionar 4 imagens</span>
                <span class="text-xs text-slate-500">PNG ou JPG · elas substituem as atuais</span>
              </label>
              <input id="upload" type="file" name="imagens" accept="image/*" multiple class="hidden">
              <div id="preview" class="mt-4 flex flex-wrap gap-3"></div>
            </div>

            <button type="submit" class="btn-primary w-full">
              {{icone "check" class="w-4 h-4"}} Salvar produto
            </button>
          </form>

          <div class="space-y-6">
            <div class="card p-6">
              <h3 class="font-display text-base font-semibold text-white">Prévia da oferta</h3>
              <div class="mt-4 rounded-2xl border border-white/10 bg-slate-950/60 p-5">
                <p class="text-sm text-slate-400">{{produto.nome}}</p>
                <div class="mt-2 flex items-end gap-3">
                  {{#if produto.preco_sem_desconto}}
                    <span class="text-sm text-slate-500 line-through">R$ {{produto.preco_sem_desconto}}</span>
                  {{/if}}
                  <span class="font-display text-3xl font-extrabold text-white">R$ {{produto.preco_com_desconto}}</span>
                </div>
                <p class="mt-3 line-clamp-4 whitespace-pre-line text-xs leading-relaxed text-slate-500">{{produto.descricao}}</p>
              </div>
            </div>

            <div class="card p-6">
              <h3 class="font-display text-base font-semibold text-white">Imagens atuais</h3>
              <div class="mt-4 grid grid-cols-2 gap-3">
                {{#each (array imagemAtual.caminho1 imagemAtual.caminho2 imagemAtual.caminho3 imagemAtual.caminho4)}}
                  <div class="aspect-square overflow-hidden rounded-xl border border-white/10 bg-slate-900">
                    {{#if this}}
                      <img src="/uploads/{{this}}" alt="Imagem do produto" class="h-full w-full object-cover">
                    {{else}}
                      <div class="grid h-full w-full place-items-center text-slate-700">{{icone "image" class="w-6 h-6"}}</div>
                    {{/if}}
                  </div>
                {{/each}}
              </div>
            </div>
          </div>
        </div>
      </section>

      {{!-- ---------- LINK DE DOWNLOAD ---------- --}}
      <section data-conteudo="entrega" class="hidden">
        <div class="grid gap-6 xl:grid-cols-[1.1fr_.9fr]">
          <form method="POST" action="/painel/link-download" class="card space-y-6 p-6 sm:p-8">
            <div>
              <span class="eyebrow">{{icone "mail" class="w-3.5 h-3.5"}} Entrega automática</span>
              <h2 class="mt-4 font-display text-2xl font-bold text-white">Link de download do e-mail</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-400">
                Este é o link enviado ao cliente assim que o pagamento Pix é <strong class="text-white">aprovado</strong>.
                Pode ser um link do Google Drive, Dropbox, OneDrive ou do seu próprio servidor.
              </p>
            </div>

            <div>
              <label class="label" for="link_download">Link de download</label>
              <input id="link_download" name="link_download" type="url" value="{{link_download}}"
                     placeholder="https://drive.google.com/file/d/SEU-ARQUIVO/view" class="field font-mono text-xs" required>
              <p class="mt-1.5 text-xs text-slate-500">Dica: use um link público de visualização (“qualquer pessoa com o link”).</p>
            </div>

            {{#if link_download}}
              <a href="{{link_download}}" target="_blank" rel="noopener"
                 class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-xs font-semibold text-slate-200 transition hover:bg-white/10">
                {{icone "external" class="w-4 h-4"}} Testar link atual
              </a>
            {{/if}}

            <button type="submit" class="btn-primary w-full">
              {{icone "check" class="w-4 h-4"}} Salvar link
            </button>
          </form>

          <div class="card p-6 sm:p-8">
            <h3 class="font-display text-base font-semibold text-white">Como funciona a entrega</h3>
            <ol class="mt-5 space-y-4">
              <li class="flex gap-3">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-brand-500/15 text-xs font-bold text-brand-300">1</span>
                <p class="text-sm leading-relaxed text-slate-400">O cliente paga com o QR Code Pix gerado na landing page.</p>
              </li>
              <li class="flex gap-3">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-brand-500/15 text-xs font-bold text-brand-300">2</span>
                <p class="text-sm leading-relaxed text-slate-400">O Mercado Pago avisa o servidor pelo webhook <code class="rounded bg-white/5 px-1.5 py-0.5 font-mono text-xs text-brand-300">/webhook</code>.</p>
              </li>
              <li class="flex gap-3">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-pix-500/15 text-xs font-bold text-pix-300">3</span>
                <p class="text-sm leading-relaxed text-slate-400">Com o pagamento aprovado, o e-mail com o botão de download é enviado automaticamente (uma única vez).</p>
              </li>
              <li class="flex gap-3">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-pix-500/15 text-xs font-bold text-pix-300">4</span>
                <p class="text-sm leading-relaxed text-slate-400">Se necessário, reenvie o link pela aba <strong class="text-white">Vendas → Aprovadas</strong>.</p>
              </li>
            </ol>

            <div class="mt-6 rounded-xl border border-amber-500/25 bg-amber-500/10 p-4 text-sm text-amber-200">
              <p class="flex items-start gap-2">
                {{icone "alert" class="mt-0.5 w-4 h-4 shrink-0"}}
                <span>Sem o link configurado (ou sem a <code class="font-mono text-xs">API_KEY</code> do Mailgun no <code class="font-mono text-xs">.env</code>), o pagamento é aprovado mas o e-mail não sai.</span>
              </p>
            </div>
          </div>
        </div>
      </section>

    </main>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js"></script>
<script>
(() => {
  const $ = (sel) => document.querySelector(sel);
  const $$ = (sel) => Array.from(document.querySelectorAll(sel));

  /* ---------- Navegação entre seções ---------- */
  const titulos = {
    visao: "Visão geral",
    vendas: "Vendas",
    reembolsos: "Reembolsos",
    produto: "Produto",
    entrega: "Link de download",
  };

  function abrirSecao(nome) {
    $$("[data-conteudo]").forEach((el) => el.classList.toggle("hidden", el.dataset.conteudo !== nome));
    $$(".nav-item").forEach((botao) => {
      const ativo = botao.dataset.secao === nome;
      botao.classList.toggle("bg-brand-600/15", ativo);
      botao.classList.toggle("text-white", ativo);
      botao.classList.toggle("text-slate-400", !ativo);
      botao.classList.toggle("hover:bg-white/5", !ativo);
      botao.classList.toggle("hover:text-white", !ativo);
    });
    $("#titulo-secao").textContent = titulos[nome] || "Painel";
    fecharMenu();
    if (nome === "visao" && window.graficoVendas) window.graficoVendas.resize();
  }

  $$(".nav-item, .nav-item-link").forEach((botao) => {
    botao.addEventListener("click", () => abrirSecao(botao.dataset.secao));
  });

  /* ---------- Menu mobile ---------- */
  const abrirMenu = () => {
    $("#sidebar").classList.remove("-translate-x-full");
    $("#overlay-menu").classList.remove("hidden");
  };
  const fecharMenu = () => {
    $("#sidebar").classList.add("-translate-x-full");
    $("#overlay-menu").classList.add("hidden");
  };
  if (window.innerWidth >= 1024) $("#sidebar").classList.remove("-translate-x-full");
  $("#abrir-menu").addEventListener("click", abrirMenu);
  $("#fechar-menu").addEventListener("click", fecharMenu);
  $("#overlay-menu").addEventListener("click", fecharMenu);

  /* ---------- Abas de vendas ---------- */
  function abrirAba(nome) {
    $$(".aba").forEach((botao) => {
      const ativo = botao.dataset.aba === nome;
      botao.classList.toggle("bg-brand-600", ativo);
      botao.classList.toggle("text-white", ativo);
      botao.classList.toggle("bg-white/5", !ativo);
      botao.classList.toggle("text-slate-400", !ativo);
      botao.classList.toggle("hover:bg-white/10", !ativo);
    });
    $$("[data-painel-aba]").forEach((painel) => painel.classList.toggle("hidden", painel.dataset.painelAba !== nome));
  }
  $$(".aba").forEach((botao) => botao.addEventListener("click", () => abrirAba(botao.dataset.aba)));
  abrirAba("aprovadas");
  abrirSecao("visao");

  /* ---------- Detalhes das linhas ---------- */
  $$(".detalhes-toggle").forEach((botao) => {
    botao.addEventListener("click", () => {
      const linha = document.getElementById(botao.dataset.alvo);
      if (linha) linha.classList.toggle("hidden");
    });
  });

  /* ---------- Upload de imagens ---------- */
  const inputUpload = $("#upload");
  const preview = $("#preview");
  let arquivos = [];

  function renderizarPreview() {
    preview.innerHTML = "";
    arquivos.forEach((arquivo, indice) => {
      const caixa = document.createElement("div");
      caixa.className = "relative h-24 w-24 overflow-hidden rounded-xl border border-white/10";
      const img = document.createElement("img");
      img.src = URL.createObjectURL(arquivo);
      img.className = "h-full w-full object-cover";
      const remover = document.createElement("button");
      remover.type = "button";
      remover.className = "absolute right-1 top-1 grid h-6 w-6 place-items-center rounded-full bg-rose-600 text-xs font-bold text-white";
      remover.textContent = "×";
      remover.addEventListener("click", () => {
        arquivos.splice(indice, 1);
        renderizarPreview();
      });
      caixa.append(img, remover);
      preview.appendChild(caixa);
    });
  }

  inputUpload.addEventListener("change", () => {
    arquivos = Array.from(inputUpload.files).slice(0, 4);
    renderizarPreview();
  });

  inputUpload.closest("form").addEventListener("submit", (evento) => {
    if (arquivos.length && arquivos.length !== 4) {
      evento.preventDefault();
      alert("Selecione exatamente 4 imagens (ou nenhuma, para manter as atuais).");
    }
    const transferencia = new DataTransfer();
    arquivos.forEach((arquivo) => transferencia.items.add(arquivo));
    inputUpload.files = transferencia.files;
  });

  /* ---------- Gráfico ---------- */
  const dadosDoBanco = {{{dados}}};

  if (window.echarts) {
    const ultimos7Dias = [...Array(7)].map((_, i) => {
      const d = new Date();
      d.setDate(d.getDate() - (6 - i));
      return d.toLocaleDateString("sv-SE");
    });

    const serie = ultimos7Dias.map((dia) => {
      const registro = dadosDoBanco.find((item) => item.data === dia);
      return registro ? Number(registro.total) : 0;
    });

    const rotulos = ultimos7Dias.map((dia) => dia.slice(8) + "/" + dia.slice(5, 7));

    const grafico = echarts.init($("#grafico"), null, { renderer: "canvas" });
    window.graficoVendas = grafico;

    grafico.setOption({
      grid: { left: 8, right: 12, top: 20, bottom: 8, containLabel: true },
      tooltip: {
        trigger: "axis",
        backgroundColor: "#0f172a",
        borderColor: "rgba(148,163,184,.25)",
        textStyle: { color: "#e2e8f0" },
      },
      xAxis: {
        type: "category",
        data: rotulos,
        boundaryGap: false,
        axisLine: { lineStyle: { color: "rgba(148,163,184,.25)" } },
        axisLabel: { color: "#64748b" },
      },
      yAxis: {
        type: "value",
        minInterval: 1,
        splitLine: { lineStyle: { color: "rgba(148,163,184,.12)" } },
        axisLabel: { color: "#64748b" },
      },
      series: [
        {
          type: "line",
          smooth: true,
          symbol: "circle",
          symbolSize: 7,
          data: serie,
          lineStyle: { width: 3, color: "#6366f1" },
          itemStyle: { color: "#818cf8", borderColor: "#0f172a", borderWidth: 2 },
          areaStyle: {
            color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
              { offset: 0, color: "rgba(99,102,241,.45)" },
              { offset: 1, color: "rgba(99,102,241,0)" },
            ]),
          },
        },
      ],
    });

    window.addEventListener("resize", () => grafico.resize());
  }
})();
</script>
