   <script>
document.addEventListener('DOMContentLoaded', function() {

    // ===== MATERIALIZE INIT =====
    M.Sidenav.init(document.querySelectorAll('.sidenav'));
    M.FormSelect.init(document.querySelectorAll("select"));
    M.Collapsible.init(document.querySelectorAll(".collapsible"));
    M.Tabs.init(document.querySelectorAll(".tabs"));

    // ===== PREÇO =====
    const inputPreco = document.getElementById("preco");
    const inputHidden = document.getElementById("valorLimpo");

    const formatadorReal = new Intl.NumberFormat('pt-BR', {
        style: 'currency',
        currency: 'BRL',
        minimumFractionDigits: 2
    });

    inputPreco.addEventListener("input", function () {
        let valorLimpo = this.value.replace(/\D/g, "");
        let valorDecimal = parseFloat(valorLimpo) / 100;

        if (isNaN(valorDecimal)) {
            this.value = "";
            inputHidden.value = "";
            return;
        }

        const formatado = formatadorReal.format(valorDecimal);
        this.value = formatado;

        inputHidden.value = formatado
            .replace("R$", "")
            .replace(/\./g, "")
            .replace(",", ".")
            .trim();
    });

    // ===== PREVIEW IMAGENS =====
    let listaArquivosGlobal = [];

    window.lll = function(e) {
        const input = e.target;
        if (!input.files) return;

        const novosArquivos = Array.from(input.files);

        if (listaArquivosGlobal.length + novosArquivos.length > 4) {
            M.toast({
                html: 'Máximo 4 imagens!',
                classes: 'red'
            });

            const vagas = 4 - listaArquivosGlobal.length;
            listaArquivosGlobal = [
                ...listaArquivosGlobal,
                ...novosArquivos.slice(0, vagas)
            ];
        } else {
            listaArquivosGlobal = [
                ...listaArquivosGlobal,
                ...novosArquivos
            ];
        }

        renderizarPreview();
        input.value = "";
    };

    function renderizarPreview() {
        const preview = document.getElementById("preview");
        preview.innerHTML = "";

        preview.style.display = "flex";
        preview.style.gap = "10px";
        preview.style.flexWrap = "wrap";

        listaArquivosGlobal.forEach((arquivo, index) => {
            const url = URL.createObjectURL(arquivo);

            const container = document.createElement("div");
            container.style.position = "relative";
            container.style.width = "70px";
            container.style.height = "70px";

            const img = document.createElement("img");
            img.src = url;
            img.style.width = "100%";
            img.style.height = "100%";
            img.style.objectFit = "cover";
            img.style.borderRadius = "4px";

            const btn = document.createElement("button");
            btn.innerHTML = "×";
            btn.style.cssText = `
                position:absolute;
                top:-5px;
                right:-5px;
                background:red;
                color:white;
                border:none;
                border-radius:50%;
                width:20px;
                height:20px;
                cursor:pointer;
            `;

            btn.onclick = () => {
                listaArquivosGlobal.splice(index, 1);
                renderizarPreview();
            };

            container.appendChild(img);
            container.appendChild(btn);
            preview.appendChild(container);
        });
    }

    // ===== SINCRONIZA ANTES DO SUBMIT =====
    document.querySelector("form[action='/validateupload']")
    .addEventListener("submit", function () {
        const input = document.getElementById("upload");
        const dt = new DataTransfer();

        listaArquivosGlobal.forEach(file => dt.items.add(file));
        input.files = dt.files;
    });

});
</script>                 
                    
                        
  
                        
                    
