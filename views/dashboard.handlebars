    <script type="text/javascript">
    //aqui
      let btn_dashboard = document.getElementById("btn-dashboard");
      let btn_vendas = document.getElementById("btn-vendas");
      let dashboard = document.getElementById("dashboard");
      let vendas = document.getElementById("vendas");
      let content = document.querySelectorAll(".content-box");
      let buttons = document.querySelectorAll(".el");
      
buttons.forEach(function(item, index) {
    item.addEventListener("click", (e) => {
        
        // 1. Resetar o estado: Remove o azul de todos os botões
        buttons.forEach(btn => btn.classList.remove("blue"));
        
        // 2. Esconder todos os blocos de conteúdo
        content.forEach(box => box.classList.add("hide"));

        // 3. Ativar o que foi clicado
        item.classList.add("blue");
        
        // 4. Mostrar o conteúdo que tem o MESMO INDEX do botão
        if (content[index]) {
            content[index].classList.remove("hide");
        }
    });
});

    </script>
    
    
    <script type="text/javascript">
    var dom = document.getElementById('chart-container');
var myChart = echarts.init(dom, null, {
  renderer: 'canvas',
  useDirtyRect: false
});
var app = {};

// 1. Gera o array com as datas dos últimos 7 dias (YYYY-MM-DD)
const ultimos7Dias = [...Array(7)].map((_, i) => {
    const d = new Date();
    d.setDate(d.getDate() - (6 - i));
    // Formata como 2026-03-31 sem erro de fuso
    return d.toLocaleDateString('sv-SE'); 
});

// 2. Simulando o que o seu SELECT COUNT retornaria do banco
/*
SELECT 
    DATE(data_pedido) AS data, 
    COUNT(*) AS total 
FROM pedidos 
WHERE status_pagamento = 'approved' 
  AND data_pedido >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)
GROUP BY DATE(data_pedido)
ORDER BY data_pedido ASC;
*/
const dadosDoBanco = {{{dados}}};

// 3. Monta o array final para o Apache ECharts
const dataFinalEcharts = ultimos7Dias.map(dia => {
    const registro = dadosDoBanco.find(item => item.data === dia);
    
    // Se o registro existir no banco, usa o total, senão coloca 0
    return [dia, registro ? registro.total : 0];
});

var option;

option = {
  xAxis: {
    type: 'category',
    boundaryGap: false
  },
  yAxis: {
    type: 'value',
    boundaryGap: [0, '30%']
  },
  tooltip: {
    trigger: 'axis',
    axisPointer: {
      type: 'line' // 'line' fica melhor visualmente para gráficos de área/linha
    },
    showDelay: 0,
    hideDelay: 100,
    transitionDuration: 0.4,
    confine: true // Importante para mobile não cortar o balão
  },
  dataZoom: [
    {
      type: 'inside',
      start: 0,
      end: 100
    }
  ],
  visualMap: {
    type: 'piecewise',
    show: false,
    dimension: 0,
    seriesIndex: 0,
    pieces: [
      {
        gt: 1,
        lt: 3,
        color: 'rgba(0, 0, 180, 0.4)'
      },
      {
        gt: 5,
        lt: 7,
        color: 'rgba(0, 0, 180, 0.4)'
      }
    ]
  },
  series: [
    {
      type: 'line',
      smooth: 0.6,
      symbol: 'none',
      lineStyle: {
        color: '#5470C6',
        width: 5
      },
      markLine: {
        symbol: ['none', 'none'],
        label: { show: false },
        data: [{ xAxis: 1 }, { xAxis: 3 }, { xAxis: 5 }, { xAxis: 7 }]
      },
      areaStyle: {},
      // AQUI ESTÁ A MUDANÇA: Passamos o array completo que já está no formato [data, valor]
      data: dataFinalEcharts 
    }
  ]
};

if (option && typeof option === 'object') {
  myChart.setOption(option);
}

window.addEventListener('resize', myChart.resize);

    </script>
    
