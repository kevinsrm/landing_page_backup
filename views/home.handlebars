    document.getElementById("setcheckout").addEventListener("click", (e) => {
    e.preventDefault();
    const form = document.getElementById("form-checkout");
    form.classList.remove("hide");
    form.style.display = "block";
});

    document.querySelector("form").addEventListener("submit", () => {
    const finalizar = document.getElementById("finalizar");
    finalizar.innerText = "PROCESSANDO...";
    finalizar.classList.add("disabled");
});


document.getElementById("cpf").addEventListener("input", (e) => {
    let value = e.target.value;

    // 1. Remove tudo que não for número
    value = value.replace(/\D/g, "");

    // 2. Limita a 11 dígitos (tamanho padrão do CPF)
    value = value.substring(0, 11);

    // 3. Aplica a máscara: 000000000-00
    // O regex abaixo pega os primeiros 9 dígitos e separa os 2 últimos com um traço
    value = value.replace(/^(\d{9})(\d)/, "$1-$2");

    // 4. Atualiza o valor do campo
    e.target.value = value;
});

document.getElementById("telefone").addEventListener("input", (e) => {
    let value = e.target.value;

    // 1. Remove tudo que não for número
    value = value.replace(/\D/g, "");

    // 2. Limita a 11 dígitos
    value = value.substring(0, 11);

    // 3. Aplica a máscara dinamicamente
    if (value.length > 10) {
        // Celular: (00) 00000-0000
        value = value.replace(/^(\d{2})(\d{5})(\d{4})/, "($1) $2-$3");
    } else if (value.length > 6) {
        // Fixo ou Celular em digitação: (00) 0000-0000
        value = value.replace(/^(\d{2})(\d{4})(\d{0,4})/, "($1) $2-$3");
    } else if (value.length > 2) {
        // Apenas o DDD: (00) 0...
        value = value.replace(/^(\d{2})(\d{0,5})/, "($1) $2");
    } else if (value.length > 0) {
        // Iniciando o DDD: (0...
        value = value.replace(/^(\d*)/, "($1");
    }

    e.target.value = value;
});

document.getElementById("email").addEventListener("blur", function(e) {
    const email = e.target.value.trim().toLowerCase();
    
    // 1. Regex Robusta: Garante estrutura e proíbe caracteres especiais/duplos arrobas
    // Aceita letras, números, pontos e hífens antes do @
    const regexEstrutura = /^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$/;

    // 2. Lista de Domínios Permitidos (White Label)
    const dominiosPermitidos = ['gmail.com', 'outlook.com', 'hotmail.com', 'icloud.com', 'yahoo.com', 'msn.com'];

    if (email.length > 0) {
        const dominioDigitado = email.split('@')[1];

        // Validação de dois níveis: Estrutura + Domínio Específico
        if (!regexEstrutura.test(email) || !dominiosPermitidos.includes(dominioDigitado)) {
            
            M.toast({
                html: '<span><i class="material-icons left">error</i> Use um e-mail válido (Gmail, Outlook, etc).</span>',
                classes: 'red darken-2 rounded',
                displayLength: 4000
            });

            // Opcional: Marcar o input visualmente (Classe do Materialize)
            e.target.classList.add("invalid");
        } else {
            e.target.classList.remove("invalid");
            e.target.classList.add("valid");
        }
    }
});


let cep = document.getElementById("cep");
let in_endereco = document.getElementById("endereco");
let in_bairro = document.getElementById("bairro");
let in_cidade = document.getElementById("cidade");
let in_estado = document.getElementById("estado");


cep.addEventListener("change", async ()=>{
    try{
        let response = await fetch(`https://viacep.com.br/ws/${cep.value}/json`);
        let data = await response.json();
	let body = JSON.stringify(data);
	let error = JSON.parse(body);
	
	let endereco1 = JSON.parse(body);
        let bairro1 = JSON.parse(body);
        let cidade1 = JSON.parse(body);
        let estadoUf = JSON.parse(body);
M.updateTextFields();
 setTimeout(() => {
    M.updateTextFields();
  }, 500);
  
        if(error.erro){
	    M.toast({
  html: 'Insira um cep válido!',
  displayLength: 7000, // Tempo em milissegundos
  classes: 'rounded'
});;
	in_endereco.value = "";
	in_bairro.value = "";
	in_cidade.value = "";
	in_estado.value = "";
	}
	else{
	   
	   in_endereco.value = endereco1.logradouro;
	   in_bairro.value = bairro1.bairro;
	   in_cidade.value = cidade1.localidade;
	   in_estado.value = estadoUf.estado;
	}
    }
    catch(error){
	M.toast({
  html: 'Insira um cep válido!',
  displayLength: 7000, // Tempo em milissegundos
  classes: 'rounded'
});;
    }
})
</script>

