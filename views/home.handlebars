	<label for="telefone">Telefone</label>
        <input id="telefone" name="telefone" type="text" maxlength="15" required>
      </div>
    </div>

    <div class="row">
      <div class="input-field col s12 m4">
	<label for="cep">CEP</label>
        <input id="cep" name="cep" type="text" maxlength="8" required>
      </div>

      <div class="input-field col s12 m8">
	<label for="endereco">Endereço</label>
        <input id="endereco" name="endereco" type="text" required>
      </div>

      <div class="input-field col s12 m4">
	<label for="numero">Número</label>
        <input id="numero" name="numero" type="text" required>
      </div>
