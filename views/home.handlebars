{{!-- ============================ SCRIPTS ============================ --}}
<script>
(() => {
  const $ = (sel) => document.querySelector(sel);

  const botaoDescricao = $("#alternar-descricao");
  if (botaoDescricao) {
    botaoDescricao.addEventListener("click", () => {
      const resumo = $("#descricao-resumida");
      const completa = $("#descricao-completa");
      const expandida = botaoDescricao.getAttribute("aria-expanded") === "true";
      resumo.classList.toggle("hidden", !expandida);
      completa.classList.toggle("hidden", expandida);
      botaoDescricao.setAttribute("aria-expanded", String(!expandida));
      botaoDescricao.querySelector("span:first-child").textContent = expandida ? "Ver descrição completa" : "Mostrar menos";
      botaoDescricao.querySelector("span:last-child").textContent = expandida ? "↓" : "↑";
    });
  }

  /* ---------- Galeria ---------- */
  const imgPrincipal = $("#img-principal");
  document.querySelectorAll(".thumb").forEach((botao) => {
    botao.addEventListener("click", () => {
      if (!imgPrincipal) return;
      imgPrincipal.style.opacity = "0";
      setTimeout(() => {
        imgPrincipal.src = botao.dataset.img;
        imgPrincipal.style.opacity = "1";
      }, 160);
    });
  });

  /* ---------- Toast ---------- */
  function toast(mensagem, tipo = "info") {
    const cores = {
      info: "border-white/10 bg-slate-900 text-slate-100",
      erro: "border-rose-500/40 bg-rose-950/90 text-rose-100",
      ok: "border-emerald-500/40 bg-emerald-950/90 text-emerald-100",
    };
    const el = document.createElement("div");
    el.className = `fixed bottom-5 left-1/2 z-50 w-[calc(100%-2rem)] max-w-sm -translate-x-1/2 rounded-xl border px-4 py-3 text-sm shadow-2xl animate-pop-in ${cores[tipo] || cores.info}`;
    el.textContent = mensagem;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 4200);
  }

  function mostrarErro(texto) {
    const caixa = $("#erro-formulario");
    if (!texto) return caixa.classList.add("hidden");
    $("#erro-formulario-texto").textContent = texto;
    caixa.classList.remove("hidden");
    caixa.classList.add("flex");
  }

  /* ---------- Máscaras ---------- */
  $("#cpf").addEventListener("input", (e) => {
    let v = e.target.value.replace(/\D/g, "").slice(0, 11);
    v = v.replace(/(\d{3})(\d)/, "$1.$2").replace(/(\d{3})(\d)/, "$1.$2").replace(/(\d{3})(\d{1,2})$/, "$1-$2");
    e.target.value = v;
  });

  $("#telefone").addEventListener("input", (e) => {
    let v = e.target.value.replace(/\D/g, "").slice(0, 11);
    if (v.length > 6) v = v.replace(/(\d{2})(\d{5})(\d{0,4})/, "($1) $2-$3");
    else if (v.length > 2) v = v.replace(/(\d{2})(\d{0,5})/, "($1) $2");
    else if (v.length > 0) v = v.replace(/(\d*)/, "($1");
    e.target.value = v;
  });

  /* ---------- Checkout Pix ---------- */
  let intervaloStatus = null;
  let intervaloTempo = null;
  let pedidoAtual = null;
  let verificandoAgora = false;

  // Guardamos o pedido em andamento no navegador: se o cliente fechar a
  // aba (celular sem memória, por exemplo) e voltar depois, retomamos
  // exatamente de onde parou — com o mesmo QR Code e o status atualizado.
  const CHAVE_PEDIDO = "loja.pix.pedido";
  const VALIDADE_PEDIDO_SALVO_MS = 24 * 60 * 60 * 1000;

  function guardarPedido(dados) {
    try {
      localStorage.setItem(CHAVE_PEDIDO, JSON.stringify({ ...dados, salvoEm: Date.now() }));
    } catch {
      /* navegador sem localStorage (aba anônima restrita) — segue sem retomar */
    }
  }

  function lerPedidoGuardado() {
    try {
      const dados = JSON.parse(localStorage.getItem(CHAVE_PEDIDO) || "null");
      if (!dados?.pedido_id) return null;
      if (Date.now() - (dados.salvoEm || 0) > VALIDADE_PEDIDO_SALVO_MS) return null;
      return dados;
    } catch {
      return null;
    }
  }

  function limparPedidoGuardado() {
    try {
      localStorage.removeItem(CHAVE_PEDIDO);
    } catch {
      /* ignora */
    }
  }

  function limparIntervalos() {
    clearInterval(intervaloStatus);
    clearInterval(intervaloTempo);
    intervaloStatus = null;
    intervaloTempo = null;
  }

  function mostrar(painel) {
    ["#painel-formulario", "#painel-qr", "#painel-sucesso", "#painel-falha"].forEach((id) => {
      const el = document.querySelector(id);
      if (el) el.classList.add("hidden");
    });
    if (painel) document.querySelector(painel).classList.remove("hidden");
  }

  function iniciarContador(expiraEm) {
    const alvo = new Date(expiraEm).getTime();
    const el = $("#qr-tempo");
    const tick = () => {
      const restante = alvo - Date.now();
      if (Number.isNaN(alvo)) return;
      if (restante <= 0) {
        el.textContent = "expirado";
        clearInterval(intervaloTempo);
        return;
      }
      const min = Math.floor(restante / 60000);
      const seg = Math.floor((restante % 60000) / 1000);
      el.textContent = `${String(min).padStart(2, "0")}:${String(seg).padStart(2, "0")}`;
    };
    tick();
    intervaloTempo = setInterval(tick, 1000);
  }

  /** Mostra o QR Code do pedido (novo ou retomado do navegador). */
  function abrirPedido(dados) {
    pedidoAtual = { pedido_id: dados.pedido_id, email: dados.email };
    $("#sucesso-email").textContent = dados.email;
    $("#qr-valor").textContent = dados.valor;
    $("#qr-codigo").value = dados.qr_code || "";
    $("#qr-imagem").src = dados.qr_code_base64
      ? `data:image/png;base64,${dados.qr_code_base64}`
      : `https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=${encodeURIComponent(dados.qr_code || "")}`;

    mostrar("#painel-qr");
    iniciarContador(dados.expira_em);
    consultarStatus(dados.pedido_id);
  }

  async function checarStatus(rotulo = "polling") {
    if (!pedidoAtual?.pedido_id) return null;
    try {
      const resposta = await fetch(`/pagamento/status/${pedidoAtual.pedido_id}`);
      const dados = await resposta.json();
      if (dados.status === "approved") {
        limparIntervalos();
        limparPedidoGuardado();
        mostrar("#painel-sucesso");
        if (rotulo === "manual") toast("Pagamento confirmado! Verifique seu e-mail.", "ok");
      } else if (dados.status === "rejected" || dados.status === "cancelled") {
        limparIntervalos();
        limparPedidoGuardado();
        mostrar("#painel-falha");
      }
      return dados;
    } catch (erro) {
      console.warn("falha ao consultar status:", erro);
      return null;
    }
  }

  function consultarStatus(pedidoId) {
    if (intervaloStatus) clearInterval(intervaloStatus);
    pedidoAtual = { ...(pedidoAtual || {}), pedido_id: pedidoId };
    intervaloStatus = setInterval(() => checarStatus(), 4000);
  }

  $("#form-pix").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    mostrarErro(null);

    const nome = $("#nome").value.trim();
    const email = $("#email").value.trim();
    const cpf = $("#cpf").value.trim();

    if (nome.length < 3) return mostrarErro("Informe seu nome completo.");
    if (!/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(email)) return mostrarErro("Informe um e-mail válido para receber o download.");
    if (cpf.replace(/\D/g, "").length !== 11) return mostrarErro("Informe um CPF válido.");

    const botao = $("#btn-gerar-pix");
    const textoBotao = $("#btn-gerar-pix-texto");
    botao.disabled = true;
    textoBotao.textContent = "Gerando QR Code…";

    try {
      const resposta = await fetch("/pagamento/pix", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ nome, email, cpf, telefone: $("#telefone").value.trim() }),
      });
      const dados = await resposta.json();

      if (!dados.ok) throw new Error(dados.erro || "Não foi possível gerar o QR Code.");

      guardarPedido({
        pedido_id: dados.pedido_id,
        email,
        valor: dados.valor,
        qr_code: dados.qr_code,
        qr_code_base64: dados.qr_code_base64,
        expira_em: dados.expira_em,
      });
      abrirPedido({ ...dados, email });
      toast("QR Code gerado! Pode pagar pelo app do banco.", "info");
    } catch (erro) {
      mostrarErro(erro.message);
      toast(erro.message, "erro");
    } finally {
      botao.disabled = false;
      textoBotao.textContent = "Gerar QR Code Pix";
    }
  });

  $("#btn-copiar").addEventListener("click", async () => {
    const codigo = $("#qr-codigo");
    try {
      await navigator.clipboard.writeText(codigo.value);
    } catch {
      codigo.select();
      document.execCommand("copy");
    }
    toast("Código Pix copiado!", "ok");
  });

  /* ---------- "Já fiz o pagamento" (consulta imediata) ---------- */
  $("#btn-verificar-agora").addEventListener("click", async () => {
    if (verificandoAgora || !pedidoAtual?.pedido_id) return;
    verificandoAgora = true;
    const botao = $("#btn-verificar-agora");
    const texto = $("#btn-verificar-texto");
    const original = texto.textContent;
    botao.disabled = true;
    texto.textContent = "Procurando seu pagamento…";

    try {
      const resposta = await fetch(`/pagamento/verificar/${pedidoAtual.pedido_id}`, { method: "POST" });
      const dados = await resposta.json();
      if (dados.aprovado) {
        limparIntervalos();
        limparPedidoGuardado();
        mostrar("#painel-sucesso");
        if (dados.email_enviado) {
          toast("Pagamento confirmado! Verifique seu e-mail.", "ok");
        } else {
          toast("Pagamento confirmado! Estamos enviando o e-mail…", "ok");
        }
      } else {
        toast(dados.mensagem || "Ainda não identificamos o pagamento.", "info");
      }
    } catch (erro) {
      console.warn("falha ao verificar o pagamento:", erro);
      toast("Não foi possível verificar agora. Tente novamente.", "erro");
    } finally {
      verificandoAgora = false;
      botao.disabled = false;
      texto.textContent = original;
    }
  });

  // Ao voltar para a aba (o cliente saiu para pagar e voltou), consulta na hora.
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible" && pedidoAtual?.pedido_id) checarStatus();
  });

  function voltarAoFormulario() {
    limparIntervalos();
    limparPedidoGuardado();
    pedidoAtual = null;
    mostrar("#painel-formulario");
  }

  $("#btn-cancelar-qr").addEventListener("click", voltarAoFormulario);
  $("#btn-tentar-novamente").addEventListener("click", voltarAoFormulario);

  /* ---------- Retoma um pedido que ficou em aberto no navegador ---------- */
  (async function retomarPedidoSalvo() {
    const salvo = lerPedidoGuardado();
    if (!salvo?.qr_code) return;
    pedidoAtual = { pedido_id: salvo.pedido_id, email: salvo.email };
    const dados = await checarStatus("retomada");
    // Se o pedido saiu do estado "pendente", não reabre o QR Code.
    if (dados && dados.status !== "pending") {
      if (dados.status !== "approved") limparPedidoGuardado();
      return;
    }
    abrirPedido(salvo);
    toast("Retomamos o seu Pix em aberto.", "info");
  })();
})();
</script>
