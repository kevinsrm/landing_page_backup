<div class="relative flex min-h-dvh items-center justify-center overflow-hidden px-4 py-12">
  <div class="pointer-events-none absolute inset-0 bg-grid opacity-50"></div>

  <div class="relative w-full max-w-lg text-center">
    <p class="font-display text-7xl font-extrabold text-gradient">{{#if codigo}}{{codigo}}{{else}}404{{/if}}</p>
    <h1 class="mt-4 font-display text-2xl font-bold text-white">
      {{#if codigo}}Algo deu errado{{else}}Página não encontrada{{/if}}
    </h1>
    <p class="mt-3 text-slate-400">
      {{#if mensagem}}
        {{mensagem}}
      {{else}}
        O recurso que você procura pode ter sido movido ou não existe mais.
      {{/if}}
    </p>
    <img src="/images/404.png" alt="Ilustração de página não encontrada"
         class="mx-auto mt-6 max-w-xs rounded-2xl opacity-90">
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
      <a href="/" class="btn-primary">Voltar para a loja</a>
      <a href="/suporte" class="btn-ghost">Central de suporte</a>
    </div>
  </div>
</div>
