<style>

    /* Remove o posicionamento absoluto e fixa o label acima */
.input-field label {
  position: relative;
  top: 0;
  left: 0;
  padding-left: 0 !important;
  font-size: 0.8rem; /* Tamanho típico de labels superiores */
  color: #9e9e9e;
  transform: none !important; /* Impede a animação de subir/descer */
}

/* Adiciona um pequeno espaçamento entre o label e o input */
.input-field input {
  margin-top: 0px !important;
}

</style>
