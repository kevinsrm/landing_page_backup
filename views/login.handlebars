<div class="relative flex min-h-dvh items-center justify-center overflow-hidden px-4 py-12">
  <div class="pointer-events-none absolute inset-0 bg-grid opacity-60"></div>
  <div class="pointer-events-none absolute -top-32 left-1/2 h-[380px] w-[680px] -translate-x-1/2 rounded-full bg-brand-600/25 blur-[120px]"></div>

  <div class="relative w-full max-w-md animate-fade-up">
    <a href="/" class="mb-8 flex items-center justify-center gap-2.5">
      <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-600 text-white shadow-glow">{{icone "bolt" class="w-5 h-5"}}</span>
      <span class="font-display text-lg font-bold tracking-tight text-white">{{nomeLoja}}</span>
    </a>

    <div class="card p-7 sm:p-8">
      <div class="text-center">
        <h1 class="font-display text-2xl font-bold text-white">Acessar painel</h1>
        <p class="mt-1.5 text-sm text-slate-400">Área restrita ao administrador da loja.</p>
      </div>

      {{#if erro}}
        <div class="mt-6 flex items-start gap-2 rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-sm text-rose-200">
          {{icone "alert" class="mt-0.5 w-4 h-4 shrink-0"}}
          <span>{{erro}}</span>
        </div>
      {{/if}}

      <form method="POST" action="/loginuser" class="mt-6 space-y-5">
        <div>
          <label class="label" for="email1">E-mail</label>
          <input id="email1" name="email" type="email" autocomplete="username" required class="field" placeholder="admin@suiloja.com">
        </div>

        <div>
          <label class="label" for="senha">Senha</label>
          <input id="senha" name="senha" type="password" autocomplete="current-password" required class="field" placeholder="••••••••">
        </div>

        <div>
          <label class="label" for="2fa">Código 2FA</label>
          <input id="2fa" name="doisfa" type="text" inputmode="numeric" maxlength="6" required class="field tracking-[0.3em]" placeholder="0000">
        </div>

        <button type="submit" class="btn-primary w-full">
          {{icone "lock" class="w-4 h-4"}} Entrar
        </button>
      </form>
    </div>

    <p class="mt-6 text-center text-xs text-slate-600">
      <a href="/" class="transition hover:text-slate-400">← Voltar para a loja</a>
    </p>
  </div>
</div>
