# ============================================================
# Copie este arquivo para .env e preencha com as suas credenciais
# ============================================================

# ---------- Servidor ----------
PORT=3000
# Segredo usado para assinar o cookie de sessão (troque por um valor aleatório)
SECRET=troque-este-segredo
# URL pública do site (obrigatória para o webhook do Mercado Pago; precisa ser HTTPS)
SITE_URL=https://seu-dominio.com.br
# Nome exibido na loja / e-mails
NOME_LOJA=kevinsrm.shop

# ---------- Mercado Pago (Checkout Transparente / Pix) ----------
# Painel: https://www.mercadopago.com.br/developers/panel/applications
ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Fuso usado na expiração do QR Code
MP_TIMEZONE_OFFSET=-03:00
# Validade do QR Code em minutos
PIX_EXPIRACAO_MINUTOS=30

# ---------- Banco de dados (MySQL / MariaDB) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=orderFlow
# Certificado CA (se o seu provedor exigir)
CA_CERTIFICATE=

# ---------- Mailgun (e-mails transacionais) ----------
API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=contato.seudominio.com.br
MAILGUN_FROM=Loja <no-reply@contato.seudominio.com.br>
# Para contas na Europa use: https://api.eu.mailgun.net
# MAILGUN_URL=https://api.eu.mailgun.net

# ---------- Entrega do produto ----------
# Link padrão enviado no e-mail quando o pagamento é aprovado.
# O painel (/dash -> Link de download) tem prioridade sobre este valor.
DOWNLOAD_LINK=https://drive.google.com/file/d/SEU-ARQUIVO/view

# ---------- IA (suporte opcional) ----------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Modo demonstração (apenas para testes locais) ----------
# DB_MOCK=true  -> roda sem banco de dados (dados fictícios em memória)
# MP_MOCK=true  -> simula o Mercado Pago (QR Code fictício aprovado em ~15s)
# DB_MOCK=true
# MP_MOCK=true
